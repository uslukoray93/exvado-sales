generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique
  platform           Platform
  platformOrderId    String
  customerName       String
  customerPhone      String
  customerAddress    String
  status             OrderStatus   @default(PENDING)
  commissionRate     Float?
  shippingCost       Float         @default(0)
  desi               Int?
  orderDate          DateTime
  trackingNumber     String?
  invoiceUrl         String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  agreedDeliveryDate DateTime?
  cargoCompany       String?
  invoiceDate        DateTime?
  invoiceNumber      String?
  invoiceUploaded    Boolean       @default(false)
  paymentMethod      String?
  paymentType        Int?
  installmentCount   Int?
  ticimaxStatus      String?
  orderTotal         Float?
  items              OrderItem[]
  returnClaims       ReturnClaim[]

  @@index([orderDate])
  @@index([platform])
  @@index([status])
  @@index([paymentType])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productName   String
  sku           String
  quantity      Int
  purchasePrice Float
  salePrice     Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  stockCode     String?
  imageUrl      String?
  Order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([sku])
}

model CargoPrice {
  id          String   @id @default(cuid())
  desi        Int      @unique
  aras        Float
  dhl         Float
  kolayGelsin Float
  ptt         Float?
  surat       Float
  tex         Float?
  yurtici     Float
  cevaTedarik Float
  ceva        Float
  horoz       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([desi])
}

model CargoPriceSettings {
  id            String   @id @default(cuid())
  markupPercent Float    @default(20)
  updatedAt     DateTime @updatedAt
  updatedBy     String?

  @@map("cargo_price_settings")
}

model ReturnClaim {
  id                  String             @id @default(cuid())
  claimId             String             @unique
  orderNumber         String
  orderId             String?
  claimDate           DateTime
  lastModifiedDate    DateTime?
  customerName        String
  cargoTrackingNumber String?
  cargoProviderName   String?
  status              ReturnClaimStatus  @default(Created)
  totalRefundAmount   Float              @default(0)
  refundMethod        String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  Order               Order?             @relation(fields: [orderId], references: [id])
  audits              ReturnClaimAudit[]
  items               ReturnClaimItem[]

  @@index([claimId])
  @@index([orderNumber])
  @@index([status])
  @@index([claimDate])
}

model ReturnClaimItem {
  id              String      @id @default(cuid())
  claimId         String
  claimItemId     String      @unique
  barcode         String
  productName     String
  quantity        Int
  reasonId        Int
  reasonText      String?
  status          String?
  refundAmount    Float       @default(0)
  purchasePrice   Float       @default(0)
  customerNote    String?
  rejectionReason String?
  imageUrl        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  claim           ReturnClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([barcode])
  @@index([claimItemId])
}

model ReturnClaimAudit {
  id             String      @id @default(cuid())
  claimId        String
  claimItemId    String?
  previousStatus String?
  newStatus      String
  executorName   String?
  executorApp    String?
  date           DateTime
  notes          String?
  createdAt      DateTime    @default(now())
  claim          ReturnClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([date])
}

model ClaimIssueReason {
  id          Int      @id
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("claim_issue_reasons")
}

model InstallmentCommission {
  id                 String   @id @default(cuid())
  installmentCount   Int      @unique @map("installment_count") // Taksit sayısı (0 = Tek Çekim, 2-12 = Taksit)
  commissionRate     Float    @map("commission_rate") // Komisyon oranı (%)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("installment_commissions")
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
}

enum Platform {
  TRENDYOL
  N11
  HEPSIBURADA
  BOLBOLBUL
}

enum ReturnClaimStatus {
  Created
  WaitingInAction
  WaitingFraudCheck
  Accepted
  Unresolved
  Rejected
  Cancelled
  InAnalysis
  Completed
}
